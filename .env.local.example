# Google OAuth - get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gdrive_manager?retryWrites=true&w=majority

# Comma-separated Gmail addresses that have admin access
ADMIN_EMAILS=youremail@gmail.com,chinugaming321@gmail.com,suryaraosodi@gmail.com
